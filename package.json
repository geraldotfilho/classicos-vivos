{
  "name": "classicos-vivos",
  "private": true,
  "description": "Ferramentas de desenvolvimento dos livros Clássicos Vivos (o leitor não precisa de build: os arquivos gerados ficam versionados em assets/).",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i tools/tailwind.src.css -o assets/css/tailwind.css --minify",
    "build:fonts": "node tools/build-fonts.mjs",
    "build:icons": "node tools/build-icons.mjs",
    "build:images": "python3 tools/otimizar-imagens.py",
    "build": "npm run build:fonts && npm run build:icons && npm run build:css && npm run exportar:frases && npm run exportar:traducoes && npm run build:sw",
    "build:sw": "node tools/build-sw.mjs",
    "build:audio": "node tools/otimizar-audio.mjs",
    "exportar:frases": "node tools/exportar-frases.mjs",
    "exportar:traducoes": "node tools/traducoes.mjs exportar",
    "conferir:traducoes": "node tools/traducoes.mjs",
    "gravar:narracao": "NODE_USE_ENV_PROXY=1 node --no-warnings tools/gravar-narracao.mjs"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/fredoka": "5.1.1",
    "@fontsource/nunito": "5.1.1",
    "@phosphor-icons/core": "2.1.1",
    "tailwindcss": "3.4.17",
    "undici": "^6.29.1"
  }
}
