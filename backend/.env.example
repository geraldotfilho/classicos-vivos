# Supabase (Settings -> API)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# GitHub Fine-Grained Personal Access Token (apenas este repositório, permissão Issues: Read and write)
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=geraldotfilho
GITHUB_REPO=classicos-vivos

# Chave única secreta do Autor (desbloqueia Modo Autor no tablet e o mini-painel /admin)
AUTHOR_KEY=escolha-uma-frase-secreta-forte

# Opcional: origens extras separadas por vírgula além de geraldotfilho.github.io e localhost
ALLOWED_ORIGINS=
